+JNIEXPORT jboolean JNICALL
+Java_sun_nio_ch_KQueue_discardUrgentData(JNIEnv *env, jclass clazz, jint fd)
+{
+    int oobinline = 0;
+    int pending = 0;
+    socklen_t len = sizeof(oobinline);
+    char c;
+
+    if (getsockopt(fd, SOL_SOCKET, SO_OOBINLINE, &oobinline, &len) != 0 || oobinline != 0) {
+        return JNI_FALSE;
+    }
+    if (ioctl(fd, FIONREAD, &pending) != 0 || pending != 0) {
+        return JNI_FALSE;
+    }
+    /* EINVAL: the byte was discarded before, and the socket still sits at its mark */
+    (void) recv(fd, &c, 1, MSG_OOB | MSG_DONTWAIT);
+    return JNI_TRUE;
+}
